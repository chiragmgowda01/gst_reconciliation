# Database Connection (Supabase PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# JWT Secret for Session Authentication (minimum 32 characters, keep private)
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# CORS Origins (comma-separated, optional — development defaults are applied automatically)
# CORS_ORIGINS=http://localhost:5173,https://your-production-domain.com

# ─────────────────────────────────────────────────────────────────────────
# GST API / GST Suvidha Provider (GSP) Integration
# Status: PENDING — no live provider has been selected or authorised yet.
# See backend/services/gst_api_adapter.py for implementation instructions.
# ─────────────────────────────────────────────────────────────────────────

# Set to the name of your chosen GSP adapter once implemented (e.g. "nsdl", "karvy")
# Leave as "mock" for offline/demo/test mode.
GST_API_PROVIDER=mock

# Set to "false" once live credentials are configured and tested.
GST_API_DEMO_MODE=true

# Base URL provided by your authorised GSP (required for live mode only)
# GST_API_BASE_URL=https://api.gst.gov.in/commonapi/

# Client credentials from your authorised GSP (required for live mode only)
# GST_API_CLIENT_ID=your_gsp_client_id
# GST_API_CLIENT_SECRET=your_gsp_client_secret

# Request timeout in seconds (default 30)
# GST_API_TIMEOUT_SECONDS=30
